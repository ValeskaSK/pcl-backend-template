# Environment
NODE_ENV=development
PORT=3000

# Oracle Database
DB_HOST=localhost
DB_PORT=1521
DB_SERVICE_NAME=FREE
DB_USER=pcl_dev_user
DB_PASSWORD=pcl_dev_password

# Oracle Pool
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_INCREMENT=1

# Auth0
AUTH0_ISSUER_URL=https://dev-placeholder.auth0.com/
AUTH0_AUDIENCE=https://api.pcl.com
